{
  "name": "lookglass",
  "version": "0.1.0",
  "description": "All-in-one, offline-capable file viewer for React and Next.js — PDF, DOCX, XLSX, CSV, PPTX, images, text, JSON, XML and Markdown, built for very large files.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "bin",
    "tools",
    "README.md"
  ],
  "bin": {
    "lookglass-copy-assets": "./bin/copy-assets.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./headless": {
      "types": "./dist/headless/index.d.ts",
      "import": "./dist/headless/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./sw": {
      "types": "./dist/sw/index.d.ts",
      "import": "./dist/sw/index.js"
    },
    "./text": {
      "types": "./dist/renderers/text/index.d.ts",
      "import": "./dist/renderers/text/index.js"
    },
    "./image": {
      "types": "./dist/renderers/image/index.d.ts",
      "import": "./dist/renderers/image/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./precache-plugin": "./tools/precache-plugin.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npm run clean && npm run build:js && npm run build:types && npm run build:sw",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:js": "rollup -c",
    "build:types": "tsc -p tsconfig.build.json",
    "build:sw": "rollup -c rollup.sw.config.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "size-limit"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.11.2"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-replace": "^6.0.2",
    "@size-limit/preset-small-lib": "^11.1.6",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "happy-dom": "^16.3.0",
    "magic-string": "^0.30.17",
    "rollup": "^4.29.1",
    "rollup-plugin-esbuild": "^6.1.1",
    "size-limit": "^11.1.6",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "size-limit": [
    {
      "name": "root (server-safe: detection + types)",
      "path": "dist/index.js",
      "limit": "9 kB"
    },
    {
      "name": "react chrome + headless + core",
      "path": "dist/react/index.js",
      "limit": "27 kB"
    },
    {
      "name": "image renderer",
      "path": "dist/renderers/image/index.js",
      "limit": "5 kB"
    },
    {
      "name": "text renderer",
      "path": "dist/renderers/text/index.js",
      "limit": "12 kB"
    },
    {
      "name": "service worker routes",
      "path": "dist/sw/index.js",
      "limit": "3 kB"
    }
  ],
  "keywords": [
    "viewer",
    "file-viewer",
    "pdf",
    "docx",
    "xlsx",
    "pptx",
    "csv",
    "preview",
    "nextjs",
    "react",
    "offline"
  ],
  "engines": {
    "node": ">=20.11"
  }
}
