{
  "name": "lookglass",
  "version": "0.1.1",
  "description": "Offline-capable React and Next.js file viewer for PDF, DOCX, spreadsheets, images, code, and structured data, with large-file handling.",
  "license": "MIT",
  "homepage": "https://github.com/mmaaza/lookglass#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mmaaza/lookglass.git",
    "directory": "packages/lookglass"
  },
  "bugs": {
    "url": "https://github.com/mmaaza/lookglass/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src",
    "bin",
    "tools/precache-plugin.mjs",
    "README.md",
    "INTEGRATION.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "vendor/sheetjs/LICENSE",
    "vendor/sheetjs/VENDOR.md"
  ],
  "bin": {
    "lookglass-copy-assets": "./bin/copy-assets.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./headless": {
      "types": "./dist/headless/index.d.ts",
      "import": "./dist/headless/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./sw": {
      "types": "./dist/sw/index.d.ts",
      "import": "./dist/sw/index.js"
    },
    "./text": {
      "types": "./dist/renderers/text/index.d.ts",
      "import": "./dist/renderers/text/index.js"
    },
    "./image": {
      "types": "./dist/renderers/image/index.d.ts",
      "import": "./dist/renderers/image/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./precache-plugin": "./tools/precache-plugin.mjs",
    "./package.json": "./package.json",
    "./json": {
      "types": "./dist/renderers/json/index.d.ts",
      "import": "./dist/renderers/json/index.js"
    },
    "./xml": {
      "types": "./dist/renderers/xml/index.d.ts",
      "import": "./dist/renderers/xml/index.js"
    },
    "./markdown": {
      "types": "./dist/renderers/markdown/index.d.ts",
      "import": "./dist/renderers/markdown/index.js"
    },
    "./svg": {
      "types": "./dist/renderers/svg/index.d.ts",
      "import": "./dist/renderers/svg/index.js"
    },
    "./pdf": {
      "types": "./dist/renderers/pdf/index.d.ts",
      "import": "./dist/renderers/pdf/index.js"
    },
    "./docx": {
      "types": "./dist/renderers/docx/index.d.ts",
      "import": "./dist/renderers/docx/index.js"
    },
    "./csv": {
      "types": "./dist/renderers/csv/index.d.ts",
      "import": "./dist/renderers/csv/index.js"
    },
    "./sheet": {
      "types": "./dist/renderers/sheet/index.d.ts",
      "import": "./dist/renderers/sheet/index.js"
    }
  },
  "scripts": {
    "prepack": "npm run build && npm run test:consumer-types && node tools/prepare-package.mjs",
    "test:consumer-types": "tsc -p test/consumer-types/tsconfig.json",
    "build": "npm run clean && npm run build:js && npm run build:types && npm run build:sw",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:js": "rollup -c",
    "build:types": "tsc -p tsconfig.build.json",
    "build:sw": "rollup -c rollup.sw.config.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "size-limit"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.11.2",
    "docx-preview": "0.4.0",
    "dompurify": "^3.4.15",
    "mdast-util-to-string": "^4.0.0",
    "pdfjs-dist": "5.7.284",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^3.23.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-replace": "^6.0.2",
    "@size-limit/preset-small-lib": "^11.1.6",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "happy-dom": "^16.3.0",
    "jsdom": "^25.0.1",
    "jszip": "^3.10.1",
    "magic-string": "^0.30.17",
    "rollup": "^4.29.1",
    "rollup-plugin-esbuild": "^6.1.1",
    "size-limit": "^11.1.6",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "size-limit": [
    {
      "name": "root (server-safe: detection + types)",
      "path": "dist/index.js",
      "limit": "9 kB"
    },
    {
      "name": "react chrome + every renderer shell, excluding the PDF.js and docx-preview engines (worst case: lazy imports inlined)",
      "path": "dist/react/index.js",
      "limit": "60 kB",
      "ignore": [
        "pdfjs-dist",
        "docx-preview",
        "jszip"
      ]
    },
    {
      "name": "image renderer",
      "path": "dist/renderers/image/index.js",
      "limit": "5 kB"
    },
    {
      "name": "text renderer",
      "path": "dist/renderers/text/index.js",
      "limit": "12 kB"
    },
    {
      "name": "service worker routes",
      "path": "dist/sw/index.js",
      "limit": "3 kB"
    },
    {
      "name": "json renderer",
      "path": "dist/renderers/json/index.js",
      "limit": "12 kB"
    },
    {
      "name": "xml renderer",
      "path": "dist/renderers/xml/index.js",
      "limit": "12 kB"
    },
    {
      "name": "svg renderer (incl. DOMPurify)",
      "path": "dist/renderers/svg/index.js",
      "limit": "15 kB"
    },
    {
      "name": "markdown worker (unified + sanitiser, off main thread)",
      "path": "dist/workers/markdown.worker.js",
      "limit": "105 kB"
    },
    {
      "name": "markdown renderer shell",
      "path": "dist/renderers/markdown/index.js",
      "limit": "11 kB"
    },
    {
      "name": "pdf renderer, incl. pdf.js main-thread library (lazy)",
      "path": "dist/renderers/pdf/index.js",
      "limit": "130 kB"
    },
    {
      "name": "pdf worker (lazy, off main thread)",
      "path": "dist/workers/pdf.worker.js",
      "limit": "400 kB"
    },
    {
      "name": "docx renderer, incl. docx-preview + JSZip (lazy)",
      "path": "dist/renderers/docx/index.js",
      "limit": "75 kB"
    },
    {
      "name": "docx layout worker (OOXML core + Word engine, off main thread)",
      "path": "dist/workers/docx.worker.js",
      "limit": "40 kB"
    },
    {
      "name": "csv/sheet grid renderer shell",
      "path": "dist/renderers/sheet/index.js",
      "limit": "14 kB"
    },
    {
      "name": "csv worker (streaming indexer, off main thread)",
      "path": "dist/workers/csv.worker.js",
      "limit": "8 kB"
    },
    {
      "name": "sheet worker (vendored SheetJS + codepages, off main thread)",
      "path": "dist/workers/sheet.worker.js",
      "limit": "220 kB"
    }
  ],
  "keywords": [
    "viewer",
    "file-viewer",
    "pdf",
    "docx",
    "xlsx",
    "document-viewer",
    "typescript",
    "csv",
    "preview",
    "nextjs",
    "react",
    "offline"
  ],
  "engines": {
    "node": ">=22.13.0"
  }
}
